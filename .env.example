# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-password-here
DB_NAME=partnerportaldb

# Set to 1 only for local development. Never enable in production --
# Flask's debug mode exposes an interactive console to anyone who can reach it.
FLASK_DEBUG=1
