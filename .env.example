# Copy this file to `.env` and fill in real values.
# `.env` (and every other .env.* variant) is gitignored and must never be
# committed.

# --- Database ---------------------------------------------------------------
# Postgres connection string. Get this from your Neon project dashboard, or
# from any other Postgres host. The `postgresql://` form is fine -- the app
# rewrites it to use psycopg 3 internally.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# --- Sessions ---------------------------------------------------------------
# Signs the session cookie. Changing it logs every organization out.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# --- Server -----------------------------------------------------------------
# Set to 1 only for local development. Never enable in production --
# Flask's debug mode exposes an interactive console to anyone who can reach it.
FLASK_DEBUG=1

# Port for the local dev server. 5000 is worth avoiding on macOS, where
# AirPlay Receiver already listens on it.
PORT=5001

# Set to "production" when deployed. This makes the session cookie
# HTTPS-only, which would break local development over plain HTTP.
# FLASK_ENV=production
