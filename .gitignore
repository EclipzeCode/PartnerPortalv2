# Environment / secrets
# Ignore every .env variant (.env.local, .env.backup, .env.production, ...)
# and re-admit only the committed template, so a stray copy of a real .env
# can never be added by accident.
.env
.env.*
!.env.example

# Python
venv/
__pycache__/
*.py[cod]
*.egg-info/

# Node
node_modules/

# Editor / OS
.vscode/
.claude/settings.local.json
.DS_Store
Thumbs.db

# Local SQL scratch files
*.session.sql

# Agent / editor tooling installed by `neon init`. Regenerable by re-running
# it, and not part of the application, so it stays out of the repo.
.agents/
.claude/
skills-lock.json
